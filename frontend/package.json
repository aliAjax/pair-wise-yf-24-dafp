{
  "name": "policy-diff-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test:lifecycle": "esbuild tests/lifecycle.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/lifecycle.mjs && node node_modules/.tmp/lifecycle.mjs",
    "test:ssr": "vite build --config vite.ssr.config.ts && node node_modules/.tmp/ssr-dist/ssr.smoke.js",
    "test": "npm run test:lifecycle && npm run test:ssr"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "element-plus": "^2.8.1",
    "pinia": "^2.2.2",
    "vue": "^3.4.38",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.1.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vue-tsc": "^2.0.29"
  }
}
